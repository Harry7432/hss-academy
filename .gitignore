# Dependências
node_modules/
.pnpm-store/

# Artefatos de build e compilação
dist/
dist-electron/
release/

# Logs e depuração
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Arquivos de sistema e editores
.DS_Store
Thumbs.db
desktop.ini
